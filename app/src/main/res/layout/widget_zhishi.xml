<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light">

    <ImageView
        android:id="@+id/wBgImg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="10dp"
        android:weightSum="2">

        <!-- Left column: Date header + Today's courses -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/date_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="24"
                    android:textColor="#FF000000"
                    android:textSize="31dp" />

                <ImageView
                    android:id="@+id/week_divider_1"
                    android:layout_width="0.5dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#FFD9D9D9" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/week_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="13"
                        android:textColor="#FF888888"
                        android:textSize="12dp" />

                    <TextView
                        android:id="@+id/week_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="周"
                        android:textColor="#FF888888"
                        android:textSize="12dp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/week_divider_2"
                    android:layout_width="0.5dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="#FFD9D9D9" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="周"
                        android:textColor="#FFFF453A"
                        android:textSize="12dp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/day_of_week"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="二"
                        android:textColor="#FFFF453A"
                        android:textSize="12dp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Left Course 0 -->
            <LinearLayout
                android:id="@+id/left_item_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/left_bar_0"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/left_name_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/left_time_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/left_loc_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Left Course 1 -->
            <LinearLayout
                android:id="@+id/left_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/left_bar_1"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/left_name_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/left_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/left_loc_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Left Course 2 -->
            <LinearLayout
                android:id="@+id/left_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/left_bar_2"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/left_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/left_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/left_loc_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/left_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="没有课程"
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/left_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还有更多课程"
                android:textColor="#FF888888"
                android:textSize="11dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right column: Tomorrow / Future courses -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/future_date_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="明天"
                android:textColor="#FF3C3C3C"
                android:textSize="12dp" />

            <!-- Right Course 0 -->
            <LinearLayout
                android:id="@+id/right_item_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/right_bar_0"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/right_name_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/right_time_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/right_loc_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Course 1 -->
            <LinearLayout
                android:id="@+id/right_item_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/right_bar_1"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/right_name_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/right_time_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/right_loc_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Right Course 2 -->
            <LinearLayout
                android:id="@+id/right_item_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/right_bar_2"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:scaleType="fitXY" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:orientation="vertical">
                    <TextView android:id="@+id/right_name_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11.5dp" android:textStyle="bold" />
                    <TextView android:id="@+id/right_time_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="11dp" />
                    <TextView android:id="@+id/right_loc_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:includeFontPadding="false" android:singleLine="true" android:textColor="#FF000000" android:textSize="12dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/right_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="没有课程"
                android:textColor="#FF888888"
                android:textSize="14sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/right_more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="还有更多课程"
                android:textColor="#FF888888"
                android:textSize="11dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
